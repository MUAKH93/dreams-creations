spring.application.name=dreams-creations

# --- Single-tenant mode (default): use spring.datasource below ---
# --- Multi-tenant mode: set app.multitenancy.enabled=true and configure tenants.* (each tenant = separate MySQL database) ---
app.multitenancy.enabled=false
app.multitenancy.default-tenant-id=default

spring.datasource.url=jdbc:mysql://localhost:3306/dreams_creations_db?useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Example second tenant (only when app.multitenancy.enabled=true):
# app.multitenancy.tenants.default.display-name=Dreams Creations (Main)
# app.multitenancy.tenants.default.datasource.url=jdbc:mysql://localhost:3306/dreams_creations_db?useSSL=false&serverTimezone=UTC
# app.multitenancy.tenants.default.datasource.username=root
# app.multitenancy.tenants.default.datasource.password=YOUR_DB_PASSWORD
# app.multitenancy.tenants.acme.display-name=Acme Factory
# app.multitenancy.tenants.acme.datasource.url=jdbc:mysql://localhost:3306/dreams_acme_db?useSSL=false&serverTimezone=UTC
# app.multitenancy.tenants.acme.datasource.username=root
# app.multitenancy.tenants.acme.datasource.password=YOUR_DB_PASSWORD

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Design images — absolute folder (avoids Tomcat temp/work dir on Windows)
app.upload.dir=${user.home}/Projects/dreams-creations/backend/uploads

# JWT — use a random secret at least 32 characters
jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY
jwt.expiration=86400000

app.frontend.url=http://localhost:3000
# Comma-separated browser origins allowed to call the API (include production URL)
app.cors.allowed-origins=http://localhost:3000,http://localhost:5173
# Dev only: return reset/verify links in API responses when mail is off
app.password-reset.expose-link=true
app.email-verification.expose-link=true

# Default packing supervisor (first name) — used until admin sets one in Factory Setup
app.production.default-packing-supervisor-name=Asif

# Optional modules — keep false on main/production until UAT merge
modules.finance.enabled=false
# After UAT: set both to true so bills/payments and COGS/inventory post journals automatically
modules.finance.auto-post-ar=true
modules.finance.auto-post-inventory=true

# API key for external shop app → finance integration (separate dreams-creations-shop project)
app.shop.integration.api-key=change-me-shop-integration-key

# Email — set app.mail.enabled=true and configure SMTP to send real emails
app.mail.enabled=false
app.mail.from=noreply@dreamscreations.local
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=your@gmail.com
# spring.mail.password=your-app-password
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true

# ── Platform super-admin (creates client factory admin accounts; not stored in tenant DB) ──
app.platform.super-admin.enabled=true
app.platform.super-admin.username=RovexaPlatformSuperAdmin
app.platform.super-admin.password=Rvx#Erp\$Platform2026!Secure

# ── Tenant factory admin seeded on startup (key = tenant id, e.g. default) ──
app.bootstrap.tenant-admins.default.username=DreamsCreationsAdmin
app.bootstrap.tenant-admins.default.password=DreamsCreationsAdminPassword!2#
app.bootstrap.tenant-admins.default.email=admin@dreamscreations.local
app.bootstrap.tenant-admins.default.first-name=Dreams
app.bootstrap.tenant-admins.default.last-name=Admin
app.bootstrap.tenant-admins.default.disable-legacy-admins=true

# Copy this file to application.properties and fill in real values.
