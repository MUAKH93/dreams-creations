# Enable on feature/finance-v2 — copy relevant lines into application.properties
# or: spring.config.import=optional:classpath:application-finance.properties

modules.finance.enabled=true
modules.finance.auto-post-ar=false
# When true: COGS on bill sales, inventory receipt on final-stage production returns
modules.finance.auto-post-inventory=false
# Payables always auto-post journals when created in the finance portal (Dr expense / Cr AP)
modules.finance.auto-post-ap=true
