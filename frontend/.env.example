# Frontend environment — copy to .env for local development
#
# Operations only (main branch / production):
#   VITE_FINANCE_MODULE_ENABLED=false
#
# Finance development (feature/finance-v2):
#   VITE_FINANCE_MODULE_ENABLED=true
#   Also set modules.finance.enabled=true in backend application.properties

VITE_FINANCE_MODULE_ENABLED=false

# Optional — default /api (same host). Use full URL if API is on another domain.
# VITE_API_BASE_URL=https://api.example.com/api
